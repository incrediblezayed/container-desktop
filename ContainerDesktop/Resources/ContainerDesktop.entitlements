<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app launches /usr/local/bin/container, which talks to launchd services.
	     That is not possible from the App Sandbox, so the app ships outside the
	     Mac App Store: Developer ID signed, hardened runtime, notarized. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
